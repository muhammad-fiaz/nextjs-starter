# Environment Variables Configuration
# Copy this file to .env.local and update with your own values

# App URL (used for metadata, open graph images, canonical URLs, sitemaps)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# VAPID Keys for Web Push Notifications
# Generate new keys using: bunx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
